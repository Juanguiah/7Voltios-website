---
import ContactCTA from "../components/ContactCTA.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import EngineeringProjectsSection from "../components/home/EngineeringProjectsSection.astro";
import HeroSection from "../components/home/HeroSection.astro";
import MobilitySection from "../components/home/MobilitySection.astro";
import PathwaysSection from "../components/home/PathwaysSection.astro";
import ProductCategoriesSection from "../components/home/ProductCategoriesSection.astro";
import WhySection from "../components/home/WhySection.astro";
import { homeStructuredData } from "../data/homeSeo";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";

const title = "7 VOLTIOS | Movilidad eléctrica y proyectos eléctricos";
const description =
  "Cargadores, instalación e infraestructura para movilidad eléctrica y desarrollo de proyectos eléctricos con respaldo de ingeniería en Colombia.";
const socialTitle = "7 VOLTIOS | Movilidad eléctrica y proyectos eléctricos";
const socialDescription =
  "Integramos tecnología, productos e ingeniería para desarrollar soluciones de movilidad eléctrica y proyectos eléctricos.";
---

<BaseLayout
  {title}
  {description}
  canonical="/"
  {socialTitle}
  {socialDescription}
  image="/img/og-image-v2.png"
  imageAlt="Infraestructura de carga e ingeniería eléctrica de 7 VOLTIOS"
  structuredData={homeStructuredData}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/img/hero-brochure-scene.webp"
    type="image/webp"
    fetchpriority="high"
  />

  <a class="skip-link" href="#contenido-principal">Saltar al contenido principal</a>
  <SiteHeader />

  <main id="contenido-principal" tabindex="-1">
    <HeroSection />
    <PathwaysSection />
    <MobilitySection />
    <EngineeringProjectsSection />
    <ProductCategoriesSection />
    <WhySection />
    <ContactCTA />
  </main>

  <SiteFooter />
</BaseLayout>
