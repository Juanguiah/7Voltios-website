---
import StoreIcon from "../StoreIcon.astro";
import type { Locale } from "../../config/i18n";
import { siteContent } from "../../data/siteContent";

interface Props {
  locale?: Locale;
}

const { locale = "es" } = Astro.props;
const copy = siteContent[locale].pathways;
const [storeCard, mobilityCard, engineeringCard] = copy.cards;
---

<section class="pathways" id="servicios" aria-labelledby="pathways-title">
  <div class="pathways__inner">
    <header class="pathways__heading">
      <span>{copy.eyebrow}</span>
      <h2 id="pathways-title">{copy.title}</h2>
      <p>{copy.intro}</p>
    </header>

    <div class="pathways__grid">
      <article class="pathway-card pathway-card--store" id="comprar-cargador">
        <div class="pathway-card__icon" aria-hidden="true">
          <StoreIcon />
        </div>
        <span class="pathway-card__category">{storeCard.category}</span>
        <h3>{storeCard.title}</h3>
        <p>{storeCard.description}</p>
        <a class="pathway-card__link" href="#tienda">
          {storeCard.cta} <span aria-hidden="true">→</span>
        </a>
      </article>

      <article class="pathway-card pathway-card--mobility" id="solucion-carga">
        <div class="pathway-card__icon" aria-hidden="true">
          <svg viewBox="0 0 48 48">
            <rect x="9" y="5" width="25" height="38" rx="5"></rect>
            <path d="M16 13h11M21 19l-4 7h5l-2 8 7-10h-5l3-5"></path>
            <path d="M34 16h3a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4h-3"></path>
          </svg>
        </div>
        <span class="pathway-card__category">{mobilityCard.category}</span>
        <h3>{mobilityCard.title}</h3>
        <p>{mobilityCard.description}</p>
        <a class="pathway-card__link" href="#movilidad-electrica">
          {mobilityCard.cta} <span aria-hidden="true">→</span>
        </a>
      </article>

      <article class="pathway-card pathway-card--engineering" id="proyecto-electrico">
        <div class="pathway-card__icon" aria-hidden="true">
          <svg viewBox="0 0 48 48" fill="none" focusable="false">
            <path d="M13 20a11 11 0 0 1 22 0M24 9v11"></path>
            <path d="M10 20h28v5H10z"></path>
            <path d="M17 25v2a7 7 0 0 0 14 0v-2"></path>
            <path d="M8 43c1-7 7-11 16-11s15 4 16 11"></path>
            <path d="m25 34-4 6h3l-1 4 5-7h-3l1-3"></path>
          </svg>
        </div>
        <span class="pathway-card__category">{engineeringCard.category}</span>
        <h3>{engineeringCard.title}</h3>
        <p>{engineeringCard.description}</p>
        <a class="pathway-card__link" href="#desarrollo-proyectos-electricos">
          {engineeringCard.cta} <span aria-hidden="true">→</span>
        </a>
      </article>
    </div>
  </div>
</section>
