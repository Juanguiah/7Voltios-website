---
import type { Locale } from "../../config/i18n";
import { siteContent } from "../../data/siteContent";
import Button from "../Button.astro";
import { getContactLinks } from "../contactLinks";

interface Props {
  locale?: Locale;
}

const { locale = "es" } = Astro.props;
const copy = siteContent[locale].engineering;
const contactLinks = getContactLinks(locale);
const localeTag = locale === "es" ? "es-CO" : "en";
---

<section
  class="engineering-projects-section"
  id="desarrollo-proyectos-electricos"
  aria-labelledby="engineering-projects-section-title"
>
  <div class="engineering-projects-section__inner">
    <header class="engineering-projects-section__header">
      <span class="engineering-projects-section__eyebrow">
        {copy.eyebrow.toLocaleUpperCase(localeTag)}
      </span>
      <h2 id="engineering-projects-section-title">{copy.title}</h2>
      <p class="engineering-projects-section__intro">{copy.intro}</p>
    </header>

    <ul class="engineering-projects-section__services" role="list">
      <li class="engineering-projects-section__service-item">
        <article class="engineering-service-card">
          <div class="engineering-service-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <path d="M8 6h32v36H8zM14 13h14M14 19h8M31 12v12M26 18h10"></path>
              <path d="m17 35 14-14 4 4-14 14-6 2 2-6Z"></path>
            </svg>
          </div>
          <h3>{copy.services[0].title}</h3>
          <p>{copy.services[0].description}</p>
        </article>
      </li>

      <li class="engineering-projects-section__service-item">
        <article class="engineering-service-card">
          <div class="engineering-service-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <path d="M12 5h24v38H12zM18 13h12M18 19h12M18 25h8"></path>
              <path d="m19 34 4 4 8-9"></path>
            </svg>
          </div>
          <h3>{copy.services[1].title}</h3>
          <p>{copy.services[1].description}</p>
        </article>
      </li>

      <li class="engineering-projects-section__service-item">
        <article class="engineering-service-card engineering-service-card--power-quality">
          <div class="engineering-service-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <path d="M5 38h38M8 8v30"></path>
              <path d="M9 28h6l4-12 7 20 5-15 4 7h8"></path>
            </svg>
          </div>
          <h3>{copy.services[2].title}</h3>
          <p>{copy.services[2].description}</p>
          <ol
            class="engineering-service-card__process"
            aria-label={copy.services[2].processLabel}
          >
            {copy.services[2].process.map((step) => <li>{step}</li>)}
          </ol>
        </article>
      </li>

      <li class="engineering-projects-section__service-item">
        <article class="engineering-service-card">
          <div class="engineering-service-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <path d="M13 20a11 11 0 0 1 22 0M24 9v11"></path>
              <path d="M10 20h28v5H10z"></path>
              <path d="M17 25v2a7 7 0 0 0 14 0v-2"></path>
              <path d="M8 43c1-7 7-11 16-11s15 4 16 11"></path>
              <path d="m25 34-4 6h3l-1 4 5-7h-3l1-3"></path>
            </svg>
          </div>
          <h3>{copy.services[3].title}</h3>
          <p>{copy.services[3].description}</p>
          <a
            class="engineering-service-card__link"
            href={contactLinks.project}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.services[3].aria}
          >{copy.services[3].cta} <span aria-hidden="true">→</span></a>
        </article>
      </li>
    </ul>

    <div class="engineering-projects-section__actions">
      <Button
        class="engineering-projects-section__action"
        href={contactLinks.engineering}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={copy.engineeringAria}
      >{copy.engineeringCta}</Button>
      <Button
        class="engineering-projects-section__action engineering-projects-section__action--secondary"
        href="#tienda"
        variant="secondary"
      >{copy.technologyCta}</Button>
    </div>
  </div>
</section>
