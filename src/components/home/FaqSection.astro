---
import { WHATSAPP_GENERAL_URL } from "../contactLinks";
import { homeFaqs } from "../../data/faqs";
---

<section class="faq-section" id="preguntas-frecuentes" aria-labelledby="faq-title">
  <div class="faq-section__inner">
    <header class="faq-section__header">
      <span>Preguntas frecuentes</span>
      <h2 id="faq-title">Respuestas claras antes de iniciar tu proyecto.</h2>
      <p>
        Aquí resolvemos las dudas más comunes sobre nuestros productos y servicios. Si tu caso es
        diferente, conversemos para entenderlo.
      </p>
    </header>

    <div class="faq-list">
      {homeFaqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>
            <span>{faq.question}</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="m7 10 5 5 5-5"></path>
            </svg>
          </summary>
          <div class="faq-item__answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="faq-section__cta">
      <p><strong>¿Tu pregunta no está aquí?</strong> Cuéntanos brevemente qué necesitas.</p>
      <a
        href={WHATSAPP_GENERAL_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Consultar otro caso por WhatsApp. Se abre en una nueva pestaña"
      >Consultar por WhatsApp <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
