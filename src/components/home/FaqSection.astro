---
import { getContactLinks } from "../contactLinks";
import type { Locale } from "../../config/i18n";
import { homeFaqsByLocale } from "../../data/faqs";
import { siteContent } from "../../data/siteContent";

interface Props {
  locale?: Locale;
}

const { locale = "es" } = Astro.props;
const copy = siteContent[locale].faq;
const faqs = homeFaqsByLocale[locale];
const contactLinks = getContactLinks(locale);
---

<section class="faq-section" id="preguntas-frecuentes" aria-labelledby="faq-title">
  <div class="faq-section__inner">
    <header class="faq-section__header">
      <span>{copy.eyebrow}</span>
      <h2 id="faq-title">{copy.title}</h2>
      <p>{copy.intro}</p>
    </header>

    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>
            <span>{faq.question}</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="m7 10 5 5 5-5"></path>
            </svg>
          </summary>
          <div class="faq-item__answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="faq-section__cta">
      <p><strong>{copy.missingQuestion}</strong> {copy.missingAnswer}</p>
      <a
        href={contactLinks.general}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={copy.ctaAria}
      >{copy.cta} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>
