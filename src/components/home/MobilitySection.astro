---
import type { Locale } from "../../config/i18n";
import { siteContent } from "../../data/siteContent";
import { getContactLinks } from "../contactLinks";

interface Props {
  locale?: Locale;
}

const { locale = "es" } = Astro.props;
const copy = siteContent[locale].mobility;
const contactLinks = getContactLinks(locale);
const localeTag = locale === "es" ? "es-CO" : "en";
---

<section
  class="mobility-section"
  id="movilidad-electrica"
  aria-labelledby="mobility-section-title"
>
  <div class="mobility-section__inner">
    <header class="mobility-section__header">
      <span class="mobility-section__eyebrow">{copy.eyebrow.toLocaleUpperCase(localeTag)}</span>
      <h2 id="mobility-section-title">{copy.title}</h2>
      <p class="mobility-section__intro">{copy.intro}</p>
    </header>

    <aside class="mobility-section__sectors" aria-labelledby="mobility-sectors-title">
      <h3 id="mobility-sectors-title">{copy.sectorsTitle}</h3>
      <ul role="list">
        {copy.sectors.map((sector) => <li>{sector}</li>)}
      </ul>
    </aside>

    <ul class="mobility-section__services" role="list">
      <li class="mobility-section__service-item">
        <article class="mobility-service-card">
          <div class="mobility-service-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <rect x="10" y="5" width="24" height="38" rx="5"></rect>
              <path d="M17 13h10M22 19l-4 7h5l-2 8 7-11h-5l3-4"></path>
              <path d="M34 16h3a4 4 0 0 1 4 4v12a4 4 0 0 1-4 4h-3"></path>
            </svg>
          </div>
          <h3>{copy.services[0].title}</h3>
          <p>{copy.services[0].description}</p>
          <a
            class="mobility-service-card__link"
            href={contactLinks.installation}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.services[0].aria}
          >{copy.services[0].cta} <span aria-hidden="true">→</span></a>
        </article>
      </li>

      <li class="mobility-section__service-item">
        <article class="mobility-service-card">
          <div class="mobility-service-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <path d="M8 35a17 17 0 1 1 32 0"></path>
              <path d="M13 35h22M24 35l9-12"></path>
              <path d="M13 22l4 3M24 18v5M35 22l-4 3"></path>
            </svg>
          </div>
          <h3>{copy.services[1].title}</h3>
          <p>{copy.services[1].description}</p>
          <a
            class="mobility-service-card__link"
            href={contactLinks.capacityStudy}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.services[1].aria}
          >{copy.services[1].cta} <span aria-hidden="true">→</span></a>
        </article>
      </li>

      <li class="mobility-section__service-item">
        <article class="mobility-service-card">
          <div class="mobility-service-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <rect x="5" y="18" width="12" height="20" rx="3"></rect>
              <rect x="31" y="18" width="12" height="20" rx="3"></rect>
              <path d="M11 18V9h26v9M24 9v29M17 28h14"></path>
              <path d="M10 24h2M36 24h2M22 31l-2 4h4l-1 4 5-7h-4l1-1"></path>
            </svg>
          </div>
          <h3>{copy.services[2].title}</h3>
          <p>{copy.services[2].description}</p>
          <a
            class="mobility-service-card__link"
            href={contactLinks.infrastructure}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={copy.services[2].aria}
          >{copy.services[2].cta} <span aria-hidden="true">→</span></a>
        </article>
      </li>
    </ul>

    <div class="mobility-section__related" role="group" aria-label={copy.relatedLabel}>
      <p>
        {copy.relatedProductsQuestion}
        <a href="#tienda">{copy.relatedProductsLink}</a>
      </p>
      <p>
        {copy.relatedEngineeringQuestion}
        <a href="#desarrollo-proyectos-electricos">
          {copy.relatedEngineeringLink}
        </a>
      </p>
    </div>
  </div>
</section>
