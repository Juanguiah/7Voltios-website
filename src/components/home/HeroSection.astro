---
import Button from "../Button.astro";
import EnergyFlow from "../EnergyFlow.astro";
import { getContactLinks } from "../contactLinks";
import type { Locale } from "../../config/i18n";
import { siteContent } from "../../data/siteContent";

interface Props {
  locale?: Locale;
}

const { locale = "es" } = Astro.props;
const copy = siteContent[locale].hero;
const contactLinks = getContactLinks(locale);
---

<section class="home-hero" aria-labelledby="home-hero-title">
  <div class="home-hero__inner">
    <div class="home-hero__content">
      <span class="home-hero__eyebrow home-hero__eyebrow--desktop">
        {copy.eyebrowDesktop}
      </span>
      <span class="home-hero__eyebrow home-hero__eyebrow--mobile">
        {copy.eyebrowMobile}
      </span>

      <h1 id="home-hero-title">
        {copy.title} <strong>{copy.titleHighlight}</strong>
      </h1>

      <p class="home-hero__lead">{copy.lead}</p>

      <div class="home-hero__actions" role="group" aria-label={copy.actionsLabel}>
        <Button href="#tienda">{copy.storeCta}</Button>
        <Button
          href={contactLinks.installation}
          variant="secondary"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={copy.installationAria}
        >{copy.installationCta}</Button>
      </div>
    </div>

    <div class="home-hero__visual" aria-hidden="true"></div>
  </div>

  <EnergyFlow variant="hero" />
</section>
