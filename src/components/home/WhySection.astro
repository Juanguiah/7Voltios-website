---
import BrandName from "../BrandName.astro";
import EnergyFlow from "../EnergyFlow.astro";
import TrustStrip from "../TrustStrip.astro";
import type { Locale } from "../../config/i18n";
import { siteContent } from "../../data/siteContent";

interface Props {
  locale?: Locale;
}

const { locale = "es" } = Astro.props;
const copy = siteContent[locale].about;
---

<section class="why" id="nosotros" aria-labelledby="about-title">
  <div class="about-copy">
    <span class="why-kicker">{copy.eyebrow}</span>
    <h2 id="about-title">{copy.title}</h2>
    <p>
      <BrandName /> {copy.paragraphs[0]}
    </p>
    <p>
      {copy.secondParagraphPrefix} <BrandName /> {copy.paragraphs[1]}
    </p>
  </div>

  <details class="why-disclosure" id="porque">
    <summary>
      <span>{copy.whyQuestion} <BrandName />?</span>
      <span class="why-disclosure__action">
        {copy.whyAction}
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="m7 10 5 5 5-5"></path>
        </svg>
      </span>
    </summary>

    <div class="why-disclosure__content">
      <h2>{copy.whyTitle}</h2>
      <p>{copy.whyIntro}</p>
      <TrustStrip {locale} />
    </div>
  </details>

  <EnergyFlow variant="secondary" />
  <EnergyFlow variant="tertiary" />
</section>
