---
import BrandName from "../BrandName.astro";
import EnergyFlow from "../EnergyFlow.astro";
import TrustStrip from "../TrustStrip.astro";
---

<section class="why" id="porque">
  <div>
    <span class="why-kicker">
      ¿Por qué <BrandName />?
    </span>
    <h2>Tecnología integrada con respaldo de ingeniería.</h2>
    <p>
      <BrandName /> es una empresa de ingeniería y tecnología especializada en movilidad eléctrica
      y proyectos eléctricos. Cada solución se desarrolla con dirección técnica directa, análisis
      riguroso y conocimiento especializado para seleccionar, diseñar e integrar tecnología segura,
      confiable y adecuada para cada proyecto.
    </p>
  </div>

  <TrustStrip />
  <EnergyFlow variant="secondary" />
  <EnergyFlow variant="tertiary" />
</section>
