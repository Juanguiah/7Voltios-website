---
import Button from "../Button.astro";
import { WHATSAPP_INSTALLATION_URL, WHATSAPP_PRODUCTS_URL } from "../contactLinks";
---

<section
  class="product-categories-section"
  id="tienda"
  aria-labelledby="product-categories-section-title"
>
  <div class="product-categories-section__inner">
    <header class="product-categories-section__header">
      <span class="product-categories-section__eyebrow">TIENDA DE MOVILIDAD ELÉCTRICA</span>
      <h2 id="product-categories-section-title">
        Tecnología especializada para cada forma de cargar.
      </h2>
      <p class="product-categories-section__intro">
        Equipos y accesorios para movilidad eléctrica, respaldados por criterio técnico para
        ayudarte a elegir e integrar la solución adecuada.
      </p>
    </header>

    <ul class="product-categories-section__categories" role="list">
      <li class="product-categories-section__category-item">
        <article class="product-category-card">
          <div class="product-category-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <rect x="8" y="12" width="27" height="28" rx="5"></rect>
              <path d="M16 12V8h11v4M17 21h9M21 27l-3 5h4l-1 4 6-8h-4l2-3"></path>
              <path d="M35 20h2a4 4 0 0 1 4 4v9a4 4 0 0 1-4 4h-2"></path>
            </svg>
          </div>
          <h3>Cargadores portátiles</h3>
          <p>Flexibilidad para cargar en diferentes ubicaciones según las condiciones del sitio.</p>
        </article>
      </li>

      <li class="product-categories-section__category-item">
        <article class="product-category-card">
          <div class="product-category-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <rect x="10" y="5" width="24" height="38" rx="5"></rect>
              <path d="M17 13h10M22 20l-4 7h5l-2 8 7-11h-5l3-4"></path>
              <path d="M34 16h3a4 4 0 0 1 4 4v11a4 4 0 0 1-4 4h-3"></path>
            </svg>
          </div>
          <h3>Wallbox</h3>
          <p>Soluciones de carga fija para hogares, copropiedades, comercios y empresas.</p>
        </article>
      </li>

      <li class="product-categories-section__category-item">
        <article class="product-category-card">
          <div class="product-category-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <path d="M8 18h14v12H8zM26 18h14v12H26z"></path>
              <path d="M22 22h4M22 26h4M12 14v4M18 14v4M30 30v4M36 30v4"></path>
              <path d="M5 24h3M40 24h3"></path>
            </svg>
          </div>
          <h3>Adaptadores y conectores de carga</h3>
          <p>
            Soluciones de conexión para diferentes vehículos, cargadores y estándares,
            seleccionadas según su compatibilidad y especificaciones eléctricas.
          </p>
        </article>
      </li>

      <li class="product-categories-section__category-item">
        <article class="product-category-card">
          <div class="product-category-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <path d="M24 4 39 10v11c0 10-6 18-15 23C15 39 9 31 9 21V10L24 4Z"></path>
              <path d="M16 27a8 8 0 0 1 16 0M24 27l5-6"></path>
              <path d="M18 34h12"></path>
            </svg>
          </div>
          <h3>Accesorios de carga</h3>
          <p>Elementos complementarios para organizar y facilitar el uso de los equipos de carga.</p>
        </article>
      </li>

      <li class="product-categories-section__category-item">
        <article class="product-category-card">
          <div class="product-category-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <path d="M24 4 39 10v11c0 10-6 18-15 23C15 39 9 31 9 21V10L24 4Z"></path>
              <path d="m25 13-7 12h7l-2 10 8-14h-7l1-8Z"></path>
            </svg>
          </div>
          <h3>Protecciones especializadas</h3>
          <p>Protección eléctrica seleccionada para sistemas e infraestructura de carga.</p>
        </article>
      </li>

      <li class="product-categories-section__category-item">
        <article class="product-category-card">
          <div class="product-category-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <path d="M7 38h34M10 33V20M19 33V13M28 33V24M37 33V8"></path>
              <path d="M8 10h8v7H8zM24 9h8v7h-8z"></path>
            </svg>
          </div>
          <h3>Sistemas de gestión y medición de carga</h3>
          <p>Control y seguimiento para administrar la demanda y el uso de los puntos de carga.</p>
        </article>
      </li>

      <li class="product-categories-section__category-item">
        <article class="product-category-card">
          <div class="product-category-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" focusable="false">
              <rect x="6" y="20" width="11" height="18" rx="3"></rect>
              <rect x="31" y="20" width="11" height="18" rx="3"></rect>
              <path d="M11.5 20V9h25v11M24 9v29M17 29h14"></path>
            </svg>
          </div>
          <h3>Tecnología para infraestructura de carga</h3>
          <p>Equipos especializados para integrar uno o múltiples puntos de carga.</p>
        </article>
      </li>
    </ul>

    <div
      class="product-categories-section__actions"
      role="group"
      aria-label="Acciones de cargadores y accesorios"
    >
      <Button
        class="product-categories-section__action product-categories-section__action--primary"
        href={WHATSAPP_PRODUCTS_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Consultar cargadores por WhatsApp. Se abre en una nueva pestaña"
      >Consultar equipos</Button>
      <Button
        class="product-categories-section__action product-categories-section__action--secondary"
        href={WHATSAPP_INSTALLATION_URL}
        variant="secondary"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Solicitar una cotización de instalación por WhatsApp. Se abre en una nueva pestaña"
      >¿Necesitas instalación? Solicita una cotización con 7 VOLTIOS</Button>
    </div>
  </div>
</section>
