---
type Variant = "hero" | "secondary" | "tertiary";

interface Props {
  variant?: Variant;
}

const { variant = "hero" } = Astro.props;

const variants = {
  hero: {
    wrapperClass: "energy-flow",
    viewBox: "0 0 1440 220",
    gradientId: "energy-line",
    filterId: "electron-glow",
    paths: [
      {
        className: "energy-line energy-line-1",
        d: "M-40 150 C170 65 350 220 585 135 S1010 72 1480 150",
      },
      {
        className: "energy-line energy-line-2",
        d: "M-40 172 C185 88 365 242 605 158 S1030 96 1480 173",
      },
      {
        className: "energy-line energy-line-3",
        d: "M-40 195 C200 112 390 260 630 183 S1060 123 1480 198",
      },
      {
        className: "energy-line energy-line-4",
        d: "M-40 125 C160 40 330 195 560 110 S980 45 1480 126",
      },
    ],
    motionPath: "M-40 150 C170 65 350 220 585 135 S1010 72 1480 150",
  },
  secondary: {
    wrapperClass: "energy-flow-secondary",
    viewBox: "0 0 1440 180",
    gradientId: "energy-line-secondary",
    filterId: "electron-glow-secondary",
    paths: [
      {
        className: "energy-line-secondary",
        d: "M-30 110 C210 35 390 165 620 100 S1050 48 1470 112",
      },
      {
        className: "energy-line-secondary energy-line-secondary-muted",
        d: "M-30 137 C225 65 415 188 650 126 S1080 78 1470 140",
      },
      {
        className: "energy-line-secondary energy-line-secondary-muted",
        d: "M-30 82 C190 12 365 140 590 72 S1015 20 1470 84",
      },
    ],
    motionPath: "M-30 110 C210 35 390 165 620 100 S1050 48 1470 112",
  },
  tertiary: {
    wrapperClass: "energy-flow-tertiary",
    viewBox: "0 0 1440 180",
    gradientId: "energy-line-tertiary",
    filterId: "electron-glow-tertiary",
    paths: [
      {
        className: "energy-line-tertiary",
        d: "M-30 105 C205 32 390 160 620 96 S1050 44 1470 108",
      },
      {
        className: "energy-line-tertiary energy-line-tertiary-muted",
        d: "M-30 132 C220 62 410 184 648 122 S1080 74 1470 136",
      },
      {
        className: "energy-line-tertiary energy-line-tertiary-muted",
        d: "M-30 78 C185 8 360 136 588 68 S1015 16 1470 80",
      },
    ],
    motionPath: "M-30 105 C205 32 390 160 620 96 S1050 44 1470 108",
  },
} satisfies Record<
  Variant,
  {
    wrapperClass: string;
    viewBox: string;
    gradientId: string;
    filterId: string;
    paths: Array<{ className: string; d: string }>;
    motionPath: string;
  }
>;

const config = variants[variant];
---

<div class={config.wrapperClass} aria-hidden="true">
  <svg viewBox={config.viewBox} preserveAspectRatio="none">
    <defs>
      <linearGradient id={config.gradientId} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#3fd6d0" stop-opacity="0"></stop>
        <stop offset="30%" stop-color="#3fd6d0" stop-opacity="0.4"></stop>
        <stop offset="72%" stop-color="#3fd6d0" stop-opacity="0.85"></stop>
        <stop offset="100%" stop-color="#3fd6d0" stop-opacity="0"></stop>
      </linearGradient>
      <filter
        id={config.filterId}
        x="-300%"
        y="-300%"
        width="700%"
        height="700%"
      >
        <feGaussianBlur stdDeviation="9" result="blur"></feGaussianBlur>
        <feMerge>
          <feMergeNode in="blur"></feMergeNode>
          <feMergeNode in="SourceGraphic"></feMergeNode>
        </feMerge>
      </filter>
    </defs>

    {config.paths.map((path) => (
      <path class={path.className} d={path.d}></path>
    ))}

    <circle
      class="energy-electron"
      r="6"
      filter={`url(#${config.filterId})`}
    >
      <animateMotion
        dur="7s"
        repeatCount="indefinite"
        path={config.motionPath}
      ></animateMotion>
    </circle>
  </svg>
</div>
