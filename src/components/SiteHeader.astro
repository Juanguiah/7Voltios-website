---
import BrandLogo from "./BrandLogo.astro";
import { WHATSAPP_QUOTE_URL } from "./contactLinks";

interface Props {
  homeHref?: string;
  mobilityHref?: string;
  engineeringHref?: string;
  storeHref?: string;
  aboutHref?: string;
  whatsappHref?: string;
}

const {
  homeHref = "/",
  mobilityHref = "/#movilidad-electrica",
  engineeringHref = "/#desarrollo-proyectos-electricos",
  storeHref = "/#tienda",
  aboutHref = "/#porque",
  whatsappHref = WHATSAPP_QUOTE_URL,
} = Astro.props;
---

<header class="header">
  <div class="header__inner">
    <BrandLogo href={homeHref} class="logo" />

    <nav class="nav" id="primary-navigation" aria-label="Navegación principal">
      <a class="nav-home" href={homeHref} aria-label="Inicio">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="m3 11 9-8 9 8"></path>
          <path d="M5 10v10h5v-6h4v6h5V10"></path>
        </svg>
        <span class="nav-home__label">Inicio</span>
        <span class="nav-home__tooltip" aria-hidden="true">Inicio</span>
      </a>
      <a class="nav-store" href={storeHref}>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"></path>
          <path d="m13.2 7-4 6h3.2l-1.2 4 4.2-6h-3.2l1-4Z"></path>
        </svg>
        <span>Tienda</span>
      </a>
      <a href={mobilityHref}>Movilidad eléctrica</a>
      <a href={engineeringHref}>Desarrollo de proyectos eléctricos</a>
      <a href={aboutHref}>Nosotros</a>
    </nav>

    <div class="header__actions">
      <a
        class="header-btn"
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Solicitar una cotización por WhatsApp. Se abre en una nueva pestaña"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
          <path d="M20.5 11.5a8.5 8.5 0 0 1-12.7 7.4L3 20.5l1.6-4.7a8.5 8.5 0 1 1 15.9-4.3Z"></path>
          <path d="M8.4 7.7c.4 3.9 3.5 7 7.4 7.5"></path>
          <path d="m8.4 7.7 1.8-.7 1.2 2.2-1.1 1M15.8 15.2l.7-1.8-2.2-1.2-1 1.1"></path>
        </svg>
        <span class="header-btn__label">Cotizar</span>
      </a>

      <button
        class="menu-toggle"
        id="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-controls="primary-navigation"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>
