---
import {
  CONTACT_EMAIL,
  INSTAGRAM_HANDLE,
  INSTAGRAM_URL,
  getContactLinks,
} from "./contactLinks";
import type { Locale } from "../config/i18n";
import { siteContent } from "../data/siteContent";

interface Props {
  locale?: Locale;
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  whatsappHref?: string;
  emailHref?: string;
}

const locale = Astro.props.locale ?? "es";
const copy = siteContent[locale].contact;
const contactLinks = getContactLinks(locale);
const id = Astro.props.id ?? "contacto";
const eyebrow = Astro.props.eyebrow ?? copy.eyebrow;
const title = Astro.props.title ?? copy.title;
const description = Astro.props.description ?? copy.description;
const whatsappHref = Astro.props.whatsappHref ?? contactLinks.general;
const emailHref = Astro.props.emailHref ?? contactLinks.email;
---

<section class="contact" id={id}>
  <div class="contact__intro">
    <span>{eyebrow}</span>
    <h2>{title}</h2>
    <p>{description}</p>
  </div>

  <div class="contact-buttons" aria-label={copy.channelsLabel}>
    <a
      class="contact-channel contact-channel--whatsapp"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={copy.whatsappAria}
    >
      <span class="contact-channel__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" focusable="false">
          <path d="M20.5 11.5a8.5 8.5 0 0 1-12.7 7.4L3 20.5l1.6-4.7a8.5 8.5 0 1 1 15.9-4.3Z"></path>
          <path d="M8.4 7.7c.4 3.9 3.5 7 7.4 7.5"></path>
          <path d="m8.4 7.7 1.8-.7 1.2 2.2-1.1 1M15.8 15.2l.7-1.8-2.2-1.2-1 1.1"></path>
        </svg>
      </span>
      <span class="contact-channel__copy">
        <small>{copy.whatsappEyebrow}</small>
        <strong>{copy.whatsappTitle}</strong>
        <span>{copy.whatsappDescription}</span>
      </span>
    </a>
    <a class="contact-channel contact-channel--email" href={emailHref}>
      <span class="contact-channel__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" focusable="false">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m4 7 8 6 8-6"></path>
        </svg>
      </span>
      <span class="contact-channel__copy">
        <small>{copy.emailEyebrow}</small>
        <strong>{CONTACT_EMAIL}</strong>
        <span>{copy.emailDescription}</span>
      </span>
    </a>
    <a
      class="contact-channel contact-channel--instagram"
      href={INSTAGRAM_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={copy.instagramAria}
    >
      <span class="contact-channel__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" focusable="false">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
      </span>
      <span class="contact-channel__copy">
        <small>{copy.instagramEyebrow}</small>
        <strong>{INSTAGRAM_HANDLE}</strong>
        <span>{copy.instagramDescription}</span>
      </span>
    </a>
  </div>
</section>
