---
import {
  CONTACT_EMAIL,
  EMAIL_CONTACT_URL,
  WHATSAPP_CONTACT_URL,
} from "./contactLinks";

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
  whatsappHref?: string;
  emailHref?: string;
}

const {
  id = "contacto",
  eyebrow = "Hablemos de tu proyecto",
  title = "¿Necesitas un cargador, una instalación o una solución de ingeniería?",
  description =
    "Cuéntanos qué necesitas y te ayudaremos a definir el siguiente paso.",
  whatsappHref = WHATSAPP_CONTACT_URL,
  emailHref = EMAIL_CONTACT_URL,
} = Astro.props;
---

<section class="contact" id={id}>
  <div class="contact__intro">
    <span>{eyebrow}</span>
    <h2>{title}</h2>
    <p>{description}</p>
  </div>

  <div class="contact-buttons" aria-label="Canales de atención">
    <a
      class="contact-channel contact-channel--whatsapp"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Escríbenos por WhatsApp. Se abre en una nueva pestaña"
    >
      <span class="contact-channel__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" focusable="false">
          <path d="M20.5 11.5a8.5 8.5 0 0 1-12.7 7.4L3 20.5l1.6-4.7a8.5 8.5 0 1 1 15.9-4.3Z"></path>
          <path d="M8.4 7.7c.4 3.9 3.5 7 7.4 7.5"></path>
          <path d="m8.4 7.7 1.8-.7 1.2 2.2-1.1 1M15.8 15.2l.7-1.8-2.2-1.2-1 1.1"></path>
        </svg>
      </span>
      <span class="contact-channel__copy">
        <small>Atención comercial</small>
        <strong>WhatsApp</strong>
        <span>Inicia una conversación directa para cotizar.</span>
      </span>
    </a>
    <a class="contact-channel contact-channel--email" href={emailHref}>
      <span class="contact-channel__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" focusable="false">
          <rect x="3" y="5" width="18" height="14" rx="2"></rect>
          <path d="m4 7 8 6 8-6"></path>
        </svg>
      </span>
      <span class="contact-channel__copy">
        <small>Correo de proyectos</small>
        <strong>{CONTACT_EMAIL}</strong>
        <span>Envía información o documentos de tu proyecto.</span>
      </span>
    </a>
  </div>
</section>
