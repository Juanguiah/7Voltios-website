---
export interface Props {
  title: string;
  description: string;
  socialTitle?: string;
  socialDescription?: string;
  canonical?: string | URL;
  image?: string | URL;
  imageAlt?: string;
  type?: "website" | "article" | "product";
  noindex?: boolean;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  socialTitle = title,
  socialDescription = description,
  canonical,
  image = "/img/og-image-v2.png",
  imageAlt = "7 VOLTIOS · Ingeniería y tecnología energética",
  type = "website",
  noindex = false,
  robots,
  structuredData,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = canonical
  ? new URL(canonical, siteOrigin)
  : new URL(Astro.url.pathname, siteOrigin);
const socialImageURL = new URL(image, siteOrigin);
const isVercelPreview = process.env.VERCEL_ENV === "preview";
const shouldNoIndex = noindex || isVercelPreview;
const robotsContent = shouldNoIndex
  ? "noindex, nofollow, noarchive"
  : (robots ??
    "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1");
const jsonLd = structuredData ? JSON.stringify(structuredData) : undefined;
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={canonicalURL} />

<meta property="og:title" content={socialTitle} />
<meta property="og:site_name" content="7 VOLTIOS" />
<meta property="og:description" content={socialDescription} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="es_CO" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={socialDescription} />
<meta name="twitter:image" content={socialImageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
