---
import SEOHead from "../components/SEOHead.astro";
import "../styles/global.css";
import "../styles/shell.css";

export interface Props {
  title?: string;
  description?: string;
  socialTitle?: string;
  socialDescription?: string;
  canonical?: string | URL;
  image?: string | URL;
  imageAlt?: string;
  type?: "website" | "article" | "product";
  noindex?: boolean;
  bodyClass?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  lang?: string;
  ogLocale?: string;
  alternateOgLocale?: string;
  alternates?: Array<{
    hreflang: string;
    href: string | URL;
  }>;
  manifestHref?: string;
}

const {
  title = "7 VOLTIOS | Movilidad Eléctrica y Proyectos Eléctricos",
  description = "Cargadores, instalación e infraestructura para movilidad eléctrica y desarrollo de proyectos eléctricos con respaldo de ingeniería en Colombia.",
  socialTitle,
  socialDescription,
  canonical,
  image,
  imageAlt,
  type,
  noindex,
  bodyClass,
  structuredData,
  lang = "es-CO",
  ogLocale = "es_CO",
  alternateOgLocale,
  alternates,
  manifestHref = "/site.webmanifest?v=20261029-bilingual",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#031326" />

    <SEOHead
      {title}
      {description}
      {socialTitle}
      {socialDescription}
      {canonical}
      {image}
      {imageAlt}
      {type}
      {noindex}
      {structuredData}
      {ogLocale}
      {alternateOgLocale}
      {alternates}
    />

    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/img/favicon-7v-16.png?v=20260727-master"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/img/favicon-7v-32.png?v=20260727-master"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href="/img/favicon-7v-48.png?v=20260727-master"
    />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/img/favicon-7v-180.png?v=20260727-master"
    />
    <link rel="manifest" href={manifestHref} />

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />

    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
